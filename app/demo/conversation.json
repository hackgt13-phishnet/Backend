  "messages": [
    {
      "id": "d6db0ee2-3b49-5a74-8c44-550edac1664f",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "2a29af2f-b471-594c-9b4c-50e9f6e41369",
      "sent_at": "2026-09-03T18:00:00Z",
      "text": "Atlanta food is great, but a forty-minute brunch line is not a personality."
    },
    {
      "id": "128ee7da-42e0-5c36-a32c-8b6510e8605c",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "26251188-6704-5889-bf15-8ea0e279dfa2",
      "sent_at": "2026-09-03T18:01:00Z",
      "text": "Disagree. I would queue for those peach waffles again."
    },
    {
      "id": "33028886-a053-5c83-b9ae-b13a78f579df",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "a6cfac88-c223-564e-8007-757609a8d5e8",
      "sent_at": "2026-09-03T18:02:00Z",
      "text": "Next food tour needs a spreadsheet. Three stops, no brunch queue."
    },
    {
      "id": "00851cf9-3a5b-5be1-af57-d1fc5f5bbf92",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "c6a3878e-7dc1-5612-b6dc-a80d17e200bd",
      "sent_at": "2026-09-03T18:03:00Z",
      "text": "I volunteer to rate the fries at every stop."
    },
    {
      "id": "b1b48134-2f6f-57cc-bb57-e24691d15d08",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "c6a3878e-7dc1-5612-b6dc-a80d17e200bd",
      "sent_at": "2026-09-06T18:04:00Z",
      "text": "Still thinking about our rainy picnic at Lake Juniper. Best soggy sandwiches."
    },
    {
      "id": "917e1d14-3649-5589-8bb3-e7fc3ee31a6d",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "2a29af2f-b471-594c-9b4c-50e9f6e41369",
      "sent_at": "2026-09-06T18:05:00Z",
      "text": "All four of us hiding under one tiny umbrella was peak planning."
    },
    {
      "id": "9809ed1b-2391-5428-b3b7-658d491a9426",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "26251188-6704-5889-bf15-8ea0e279dfa2",
      "sent_at": "2026-09-06T18:06:00Z",
      "text": "The weather app said ten percent! I trusted the number."
    },
    {
      "id": "68dfc2cb-99d2-58dc-b83b-9ae28ad16fab",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "a6cfac88-c223-564e-8007-757609a8d5e8",
      "sent_at": "2026-09-06T18:07:00Z",
      "text": "The emergency cafe board games saved the day."
    },
    {
      "id": "95b6a7c6-2f75-5128-a7b1-34926440b805",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "26251188-6704-5889-bf15-8ea0e279dfa2",
      "sent_at": "2026-09-10T18:08:00Z",
      "text": "I am five minutes away."
    },
    {
      "id": "2e1daf5a-3a8c-5918-867b-27b4508c79ba",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "2a29af2f-b471-594c-9b4c-50e9f6e41369",
      "sent_at": "2026-09-10T18:09:00Z",
      "text": "Five Leo minutes. Starting the ceremonial timer."
    },
    {
      "id": "e17bae69-ba9e-5de8-a810-80c918def2b7",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "26251188-6704-5889-bf15-8ea0e279dfa2",
      "sent_at": "2026-09-10T18:00:00Z",
      "text": "Okay, I am still looking for my keys. Start without me."
    },
    {
      "id": "92c9a2c6-76d1-5229-a737-b2cbc5addce9",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "c6a3878e-7dc1-5612-b6dc-a80d17e200bd",
      "sent_at": "2026-09-10T18:01:00Z",
      "text": "Uno is better with dramatic commentary anyway."
    },
    {
      "id": "76cee5fb-e849-55b8-8a40-b736eae3699a",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "a6cfac88-c223-564e-8007-757609a8d5e8",
      "sent_at": "2026-09-14T18:02:00Z",
      "text": "Sunrise hike this Saturday? Easy trail, bakery at the end."
    },
    {
      "id": "0ab2fead-3d64-560b-9bf6-fab9316b3aba",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "2a29af2f-b471-594c-9b4c-50e9f6e41369",
      "sent_at": "2026-09-14T18:03:00Z",
      "text": "I like the bakery half of this proposal."
    },
    {
      "id": "d47b6767-7489-573a-8e93-04b49f57672a",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "c6a3878e-7dc1-5612-b6dc-a80d17e200bd",
      "sent_at": "2026-09-14T18:04:00Z",
      "text": "I am in if someone brings the tiny speaker."
    },
    {
      "id": "4cb46562-7fac-5723-828c-083b9b91662f",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "26251188-6704-5889-bf15-8ea0e279dfa2",
      "sent_at": "2026-09-14T18:05:00Z",
      "text": "My hiking playlist is ready. My alarm clock is negotiating."
    },
    {
      "id": "b80f4d6d-0997-5b84-86fb-e6ce895d222a",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "a6cfac88-c223-564e-8007-757609a8d5e8",
      "sent_at": "2026-09-18T18:06:00Z",
      "text": "We actually made the trail before eight. Proud of this group."
    },
    {
      "id": "790f8ec9-cfd7-577b-8eb4-c520707f43ad",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "c6a3878e-7dc1-5612-b6dc-a80d17e200bd",
      "sent_at": "2026-09-18T18:07:00Z",
      "text": "The summit photo and cinnamon rolls deserve a reunion tour."
    },
    {
      "id": "cbb582dd-62ce-5466-8a80-c7dbfc17599d",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "2a29af2f-b471-594c-9b4c-50e9f6e41369",
      "sent_at": "2026-09-22T18:08:00Z",
      "text": "Friday game night: noodles, Uno, and the five-Leo-minute timer."
    },
    {
      "id": "d9060759-4a0f-5501-a89f-c1e59bd608b3",
      "conversation_id": "97d609ff-faed-5e63-bc9e-a6148dca95bf",
      "sender_profile_id": "a6cfac88-c223-564e-8007-757609a8d5e8",
      "sent_at": "2026-09-22T18:09:00Z",
      "text": "Booked. I will bring the score notebook again."
    }
  ],
