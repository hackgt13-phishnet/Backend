# Trusted SERVER-ONLY PostgreSQL connection; both migrations must be applied.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
# Legacy HS256 verification (leave blank if using JWKS):
SUPABASE_JWT_SECRET=
# Pin these to the same project. JWKS takes precedence when nonempty.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
ALLOWED_ORIGINS=http://localhost:8081
# Unused by the synchronization fixture; reserved for the AI teammate.
META_MUSE_API_KEY=
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=muse-spark-1.1
