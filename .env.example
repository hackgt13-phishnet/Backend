# Trusted SERVER-ONLY PostgreSQL connection. Apply every migration in supabase/migrations.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
# New projects sign access tokens with ES256. Set the project URL so the API can fetch JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# Optional explicit JWKS/issuer. JWKS takes precedence over SUPABASE_URL when set.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Only needed for legacy projects that sign logins with HS256.
SUPABASE_JWT_SECRET=
META_MUSE_API_KEY=replace-with-meta-model-api-key
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=muse-spark-1.3
# minimal (~3s) | low | medium | high. Muse Spark reasons by default, which takes 10-17s per call.
META_MUSE_REASONING_EFFORT=minimal
ALLOWED_ORIGINS=http://localhost:8081

FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# normal (real use) or demo (fast, for recording): the conductor predicts a 60s vs 20s silence
GAME_PACE=normal
